# -----------------------------
# General
# -----------------------------
ENV=dev
LOG_LEVEL=INFO

# -----------------------------
# Paths (inside containers)
# -----------------------------
DATA_ROOT=/app/data
ARTIFACT_ROOT=/app/artifacts
CKPT_ROOT=/app/checkpoints

# -----------------------------
# Serving (FastAPI)
# -----------------------------
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
SERVE_DEVICE=cpu   # cpu or cuda
GATE_THRESHOLD=0.50
DIR_THRESHOLD=0.50
MAG_MAX_PCT=40.0

# -----------------------------
# MLflow
# -----------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=creditlimit
MLFLOW_RUN_NAME=manual_run

# Use S3-compatible artifact store (MinIO or AWS S3)
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Bucket for artifacts
MLFLOW_ARTIFACT_BUCKET=mlflow

# -----------------------------
# MinIO (S3 compatible)
# -----------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_DATA=creditlimit-data
MINIO_BUCKET_ARTIFACTS=mlflow

# -----------------------------
# Prometheus/Grafana
# -----------------------------
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
