{
  "uid": "infra",
  "title": "Infrastructure",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service!=\"\"}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "id": 2,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_service!=\"\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node Disk Usage",
      "id": 3,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes / node_filesystem_size_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Restarts",
      "id": 4,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(container_start_time_seconds[1h])",
          "refId": "A"
        }
      ]
    }
  ]
}
